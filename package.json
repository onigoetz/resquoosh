{
	"name": "@onigoetz/resquoosh",
	"version": "2.0.0",
	"repository": "onigoetz/resquoosh",
	"main": "dist/cjs/index.js",
	"module": "dist/mjs/index.js",
	"types": "dist/cjs/index.d.ts",
	"exports": {
		".": {
			"require": "./dist/cjs/index.js",
			"import": "./dist/mjs/index.js",
			"types": "./dist/cjs/index.d.ts"
		},
		"./impl.js": {
			"require": "./dist/cjs/impl.js",
			"import": "./dist/mjs/impl.js",
			"types": "./dist/cjs/impl.d.ts"
		},
		"./impl.mjs": "./dist/mjs/impl.js",
		"./impl.cjs": "./dist/cjs/impl.js"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"get-orientation": "^1.1.2",
		"image-size": "^2.0.2",
		"tinypool": "^2.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@onigoetz/gulp-typescript": "^6.0.0-alpha.1",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^4.1.10",
		"typescript": "^5.2.2",
		"vinyl-fs": "^4.0.2",
		"vitest": "^4.1.10"
	},
	"scripts": {
		"build": "./build.sh",
		"format": "biome format .",
		"check": "biome check .",
		"test": "vitest run",
		"test:ci": "vitest run --coverage"
	},
	"packageManager": "yarn@4.17.1"
}
